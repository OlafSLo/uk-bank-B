FROM python:3.12-slim-bookworm

ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1

ARG KLIK_GIT_URL=https://github.com/MarshallBjorn/KLIK-payments.git
ARG KLIK_GIT_REF=main

RUN apt-get update && apt-get install -y --no-install-recommends git curl \
    && rm -rf /var/lib/apt/lists/* \
    && git clone --depth 1 --branch "${KLIK_GIT_REF}" "${KLIK_GIT_URL}" /klik-upstream

WORKDIR /klik-upstream/rtgs_mock
RUN pip install --no-cache-dir -r requirements.txt

RUN useradd --create-home --shell /bin/bash mock && chown -R mock:mock /klik-upstream
USER mock

EXPOSE 9000
CMD ["uvicorn", "main:app", "--host", "0.0.0.0", "--port", "9000"]
