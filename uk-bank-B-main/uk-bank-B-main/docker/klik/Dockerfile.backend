# KLIK backend (web / worker / beat / init) — klonuje repo przy buildzie (bez osobnego checkoutu).
FROM python:3.12-slim-bookworm

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1

ARG KLIK_GIT_URL=https://github.com/MarshallBjorn/KLIK-payments.git
ARG KLIK_GIT_REF=main

RUN apt-get update && apt-get install -y --no-install-recommends git curl \
    && rm -rf /var/lib/apt/lists/* \
    && git clone --depth 1 --branch "${KLIK_GIT_REF}" "${KLIK_GIT_URL}" /klik-upstream

WORKDIR /klik-upstream/backend

RUN pip install --no-cache-dir -r requirements.txt

RUN useradd --create-home --shell /bin/bash klik \
    && chown -R klik:klik /klik-upstream
USER klik

EXPOSE 8000
