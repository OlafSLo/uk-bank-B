# UK Bank B - zmienne srodowiskowe

DATABASE_URL=postgresql://bank_user:bank_pass@localhost:5438/bank_db

# Modul kart (Payment Gateway Filipa) - musi dzialac na porcie 8072
CARD_GATEWAY_URL=http://localhost:8072
CARD_API_KEY=bank-key-uk-b
CARD_HMAC_SECRET=secret-uk-b-hmac
CARD_ADMIN_KEY=admin-secret-key-2026
CARD_ADMIN_PANEL_URL=http://localhost:3072

# W Dockerze (docker-compose.yml) uzywane jest host.docker.internal:8072 automatycznie
