# UK Bank B — porty hosta (mapa szkolna, bez kolizji z repo kolegow)
# Pelna lista: .\scripts\school-ports.ps1

# Twój bank (domyslnie 8010 — :8000 wolny dla KLIK u nich)
BANK_PORT=8010
BANK_DB_PORT=5438

# Wbudowany KLIK w docker compose (osobne porty niz repo MarshallBjorn)
KLIK_WEB_PORT=8102
KLIK_AGENT_PORT=8175

DATABASE_URL=postgresql://bank_user:bank_pass@localhost:5438/bank_db

# Modul kart (Payment Gateway Filipa) — repo FilipSl3/Karty-Platnicze-Aplikacje-Biznesowe
CARD_GATEWAY_URL=http://localhost:8072
CARD_API_KEY=bank-key-uk-b
CARD_HMAC_SECRET=secret-uk-b-hmac
CARD_ADMIN_KEY=admin-secret-key-2026
CARD_ADMIN_PANEL_URL=http://localhost:3072

# W Dockerze (docker-compose.yml) uzywane jest host.docker.internal:8072 automatycznie

# UK Payment Systems — repo noradenshi/uk-payment-systems (842x = bez kolizji z 808x)
UKPS_CHAPS_URL=http://localhost:8420
UKPS_FPS_URL=http://localhost:8421
UKPS_BACS_URL=http://localhost:8422
# Opcjonalnie - po pierwszej rejestracji klucze zapisuja sie w data/ukps_api_keys.json
# UKPS_CHAPS_API_KEY=
# UKPS_FPS_API_KEY=
# UKPS_BACS_API_KEY=
UKPS_BACS_SU_CODE=123456

# Bank partnerski — repo p-poweska/uk-bank-system
PEER_BANK_API_URL=http://localhost:8001
PEER_BANK_FRONTEND_URL=http://localhost:5173
PEER_BANK_NAME=Alice Bank (UK Bank A)
PEER_BANK_BIC=SNDRUK22
PEER_BANK_UKPS_SORT_CODE=60-00-00

# SWIFT middleware (osobne repo) — port 3000
# SWIFT_MIDDLEWARE_URL=http://localhost:3000

# KLIK — wbudowany w docker-compose.yml (docker compose up --build -d)
KLIK_BANK_API_KEY=klik_dev_uk_bank_b_school_demo
# Terminal agenta (:8175) — strefa UK, base URL /api/v1
KLIK_AGENT_API_KEY=klik_dev_agent_uk_school_demo
